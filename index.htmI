<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delta · Whitelisted</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0b0d10;
      padding: 1rem;
      position: relative;
      overflow: hidden;
    }

    /* Bolitas blancas pequeñas */
    .particles-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .particle {
      position: absolute;
      background: rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      width: 6px;
      height: 6px;
      animation: floatParticle linear infinite;
      opacity: 0.5;
    }

    @keyframes floatParticle {
      0% {
        transform: translateY(0px) translateX(0px);
        opacity: 0.2;
      }
      50% {
        transform: translateY(-100px) translateX(20px);
        opacity: 0.7;
      }
      100% {
        transform: translateY(-200px) translateX(-10px);
        opacity: 0.2;
      }
    }

    /* Tarjeta principal (glassmorphism) */
    .card {
      position: relative;
      z-index: 10;
      max-width: 420px;
      width: 100%;
      background: rgba(18, 20, 24, 0.8);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-radius: 2.5rem;
      padding: 2.5rem 2rem 2rem 2rem;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.03);
      text-align: center;
    }

    /* Badge "Successfully whitelisted!" */
    .badge {
      display: inline-block;
      background: rgba(0, 230, 118, 0.12);
      border: 1px solid rgba(0, 230, 118, 0.15);
      border-radius: 100px;
      padding: 0.3rem 1.2rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: #00e676;
      letter-spacing: 0.3px;
      margin-bottom: 1.2rem;
    }

    .badge span {
      margin-right: 4px;
    }

    h2 {
      font-size: 2rem;
      font-weight: 600;
      color: #ffffff;
      letter-spacing: -0.3px;
      margin-bottom: 0.8rem;
      background: linear-gradient(135deg, #f0f4ff, #c0d0ff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Mensaje SIN las 24 horas */
    .sub-message {
      color: rgba(200, 210, 240, 0.6);
      font-size: 0.95rem;
      font-weight: 400;
      margin-bottom: 1.8rem;
      line-height: 1.5;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    /* Caja del código */
    .code-box {
      background: rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border-radius: 1.8rem;
      padding: 1.2rem 0.8rem;
      margin-bottom: 2rem;
      border: 1px solid rgba(255, 255, 255, 0.05);
      box-shadow: inset 0 4px 12px rgba(0, 0, 0, 0.3);
    }

    .code-string {
      font-family: 'Inter', 'SF Mono', 'Fira Code', monospace;
      font-weight: 600;
      font-size: 1.3rem;
      letter-spacing: 0.8px;
      color: #eef3ff;
      word-break: break-all;
      text-align: center;
      user-select: all;
      cursor: text;
    }

    /* Botón blanco (estilo Delta) */
    .btn-copy {
      display: inline-block;
      width: 100%;
      padding: 1rem 0;
      background: #ffffff;
      color: #0b0d10;
      font-weight: 600;
      font-size: 1.1rem;
      border: none;
      border-radius: 3rem;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.2, 0.9, 0.4, 1);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.1);
      letter-spacing: 0.3px;
      margin-bottom: 1.8rem;
      position: relative;
    }

    .btn-copy:hover {
      transform: scale(1.01);
      background: #f5f9ff;
      box-shadow: 0 12px 32px rgba(0, 20, 80, 0.3);
    }

    .btn-copy:active {
      transform: scale(0.97);
    }

    .btn-copy .copied-feedback {
      display: none;
      font-weight: 500;
    }

    .btn-copy.copied .copied-feedback {
      display: inline;
    }

    .btn-copy.copied .default-text {
      display: none;
    }

    /* Footer links */
    .footer-links {
      display: flex;
      justify-content: center;
      gap: 1.8rem;
      font-size: 0.8rem;
      color: rgba(180, 195, 230, 0.4);
      border-top: 1px solid rgba(255, 255, 255, 0.03);
      padding-top: 1.5rem;
      margin-top: 0.2rem;
    }

    .footer-links a {
      color: rgba(180, 195, 230, 0.45);
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .footer-links a:hover {
      color: rgba(220, 235, 255, 0.8);
    }

    /* Toast de copiado */
    .toast-message {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%) translateY(80px);
      background: rgba(20, 30, 50, 0.9);
      backdrop-filter: blur(16px);
      padding: 0.8rem 2rem;
      border-radius: 100px;
      color: #e0ecff;
      font-weight: 500;
      font-size: 0.95rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
      opacity: 0;
      transition: opacity 0.3s ease, transform 0.3s ease;
      z-index: 999;
      pointer-events: none;
    }

    .toast-message.visible {
      opacity: 1;
      transform: translateX(-50%) translateY(0px);
    }

    @media (max-width: 480px) {
      .card {
        padding: 2rem 1.2rem 1.5rem;
        border-radius: 2rem;
      }
      h2 {
        font-size: 1.7rem;
      }
      .code-string {
        font-size: 1.1rem;
      }
      .btn-copy {
        font-size: 1rem;
        padding: 0.9rem 0;
      }
      .footer-links {
        gap: 1rem;
        flex-wrap: wrap;
      }
    }
  </style>
</head>
<body>

  <!-- Fondo de bolitas blancas PEQUEÑAS -->
  <div class="particles-bg" id="particlesContainer"></div>

  <!-- Tarjeta principal -->
  <div class="card">
    <!-- Badge -->
    <div class="badge">
      <span>✓</span> Successfully whitelisted!
    </div>

    <h2>Successfully whitelisted!</h2>

    <!-- Mensaje SIN el texto de 24 horas -->
    <div class="sub-message">
      Please return to the service for access.
    </div>

    <!-- Código: HAAHAHHS -->
    <div class="code-box">
      <div class="code-string" id="codeDisplay">https://discord.gg/Wk7sSBGRf</div>
    </div>

    <!-- Botón blanco (doble clic para copiar) -->
    <button class="btn-copy" id="copyButton">
      <span class="default-text">📋  Copiar código</span>
      <span class="copied-feedback">✓  ¡Copiado!</span>
    </button>

    <!-- Footer -->
    <div class="footer-links">
      <a href="#" onclick="return false;">Report</a>
      <a href="#" onclick="return false;">Terms of Service</a>
      <a href="#" onclick="return false;">Privacy Policy</a>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="toast-message">📋 Código copiado</div>

  <script>
    (function() {
      // ----- 1. BOLITAS BLANCAS PEQUEÑAS (sin grandes) -----
      const container = document.getElementById('particlesContainer');
      const count = 70; // bolitas pequeñas

      for (let i = 0; i < count; i++) {
        const p = document.createElement('div');
        p.classList.add('particle');

        // Tamaño entre 3px y 8px (pequeñas)
        const size = 3 + Math.floor(Math.random() * 6);
        p.style.width = size + 'px';
        p.style.height = size + 'px';

        p.style.left = Math.random() * 100 + '%';
        p.style.top = Math.random() * 100 + '%';

        const opacity = 0.2 + Math.random() * 0.4;
        p.style.opacity = opacity;

        const duration = 12 + Math.random() * 18;
        p.style.animationDuration = duration + 's';

        const delay = Math.random() * -25;
        p.style.animationDelay = delay + 's';

        container.appendChild(p);
      }

      // ----- 2. DOBLE CLIC PARA COPIAR -----
      const copyButton = document.getElementById('copyButton');
      const codeText = document.getElementById('codeDisplay').innerText.trim();
      const toast = document.getElementById('toast');

      let clickCount = 0;
      let clickTimer = null;

      function performCopy() {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(codeText)
            .then(() => showCopiedFeedback())
            .catch(() => fallbackCopy());
        } else {
          fallbackCopy();
        }
      }

      function fallbackCopy() {
        const tempInput = document.createElement('input');
        tempInput.value = codeText;
        document.body.appendChild(tempInput);
        tempInput.select();
        try {
          document.execCommand('copy');
          showCopiedFeedback();
        } catch (e) {
          alert('Copia manual: ' + codeText);
        }
        document.body.removeChild(tempInput);
      }

      function showCopiedFeedback() {
        copyButton.classList.add('copied');
        toast.classList.add('visible');
        clearTimeout(window.toastTimeout);
        window.toastTimeout = setTimeout(() => {
          toast.classList.remove('visible');
        }, 2500);
        setTimeout(() => {
          copyButton.classList.remove('copied');
        }, 3000);
      }

      copyButton.addEventListener('click', function(e) {
        e.preventDefault();
        clickCount++;

        if (clickCount === 1) {
          clickTimer = setTimeout(() => {
            clickCount = 0;
          }, 400);
        } else if (clickCount >= 2) {
          clearTimeout(clickTimer);
          clickCount = 0;
          performCopy();
        }
      });

      copyButton.addEventListener('dblclick', function(e) {
        e.preventDefault();
        clickCount = 0;
        clearTimeout(clickTimer);
      });

      // Seleccionar código al hacer clic
      document.getElementById('codeDisplay').addEventListener('click', function() {
        const range = document.createRange();
        range.selectNodeContents(this);
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
      });
    })();
  </script>
</body>
</html>
